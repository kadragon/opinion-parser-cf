{
	"name": "opinion-parser-cf",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "vite build --config src/frontend/vite.config.ts",
		"dev": "wrangler dev",
		"dev:frontend": "vite --config src/frontend/vite.config.ts",
		"build:frontend": "vite build --config src/frontend/vite.config.ts",
		"deploy": "bun run build:frontend && wrangler d1 migrations apply opinion-parser-db && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json"
	},
	"dependencies": {
		"hono": "^4.12.26",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cloudflare/vitest-pool-workers": "^0.16.18",
		"@cloudflare/workers-types": "^4.20260620.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"lefthook": "^2.1.9",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9",
		"wrangler": "^4.103.0"
	}
}
