{
	"name": "opinion-parser-cf",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "vite build --config src/frontend/vite.config.ts",
		"dev": "wrangler dev",
		"dev:frontend": "vite --config src/frontend/vite.config.ts",
		"build:frontend": "vite build --config src/frontend/vite.config.ts",
		"deploy": "bun run build:frontend && wrangler d1 migrations apply opinion-parser-db && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json"
	},
	"dependencies": {
		"hono": "^4.13.13",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20261007.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"lefthook": "^2.1.17",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	}
}
