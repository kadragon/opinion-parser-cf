{
	"name": "opinion-parser-cf",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "vite build --config src/frontend/vite.config.ts",
		"dev": "wrangler dev",
		"dev:frontend": "vite --config src/frontend/vite.config.ts",
		"build:frontend": "vite build --config src/frontend/vite.config.ts",
		"deploy": "bun run build:frontend && wrangler d1 migrations apply opinion-parser-db && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json"
	},
	"dependencies": {
		"hono": "^4.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/vitest-pool-workers": "^0.21.1",
		"@cloudflare/workers-types": "^5.20260812.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"lefthook": "^2.1.10",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.121.0"
	}
}
